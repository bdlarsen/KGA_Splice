# Whitelist source and documentation: data and results must not enter Git.
/*
!/.gitattributes
!/.gitignore
!/.dockerignore
!/Dockerfile
!/Dockerfile.minimal
!/Dockerfile.snapshot
!/compose.minimal.yaml
!/run_clinv1.sh
!/README.md
!/scripts/
!/tests/
!/docs/

# Ignore files in allowed folders unless they are source or documentation.
/scripts/*
!/scripts/*.R
!/scripts/*.sh
!/scripts/*.py
/tests/*
!/tests/*.R
!/tests/*.sh
!/tests/*.py
/docs/*
!/docs/*.md

# These patterns also apply within whitelisted folders.
*.bam
*.bai
*.csi
*.cram
*.crai
*.vcf
*.vcf.gz
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bed
*.bed.gz
*.rds
*.RData
*.Rdata
*.tsv
*.csv
*.xlsx
*.log
*.err
*.sam
.env
